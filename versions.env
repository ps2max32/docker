# Pinned inputs of the images. The workflows read this file; change a pin here
# to rebuild an image with it (llvm/* pins -> both images, the rest -> ps2max).

ALPINE=alpine:3.24

# llvm image: the R5900/VU LLVM (ps2max32/llvm, branch r5900-feature)
LLVM_REPO=https://github.com/ps2max32/llvm
LLVM_REF=57ef409bb9f7e4b430e27d80aee771be1bb71474

# ps2max image: libraries and tools
MAXSDK_REPO=https://github.com/ps2max32/maxsdk
MAXSDK_REF=2bd7476f12b97c3bfd38c3ae617ac3b380e543db
LIBGL_REPO=https://github.com/ps2max32/libgl
LIBGL_REF=8d98a76de1305bed6de0a40f91520f3d51ba2f8d
# picolibc 1.8.9 plus maxsdk's libc/picolibc-r5900.patch
PICOLIBC_REPO=https://github.com/picolibc/picolibc
PICOLIBC_REF=99c7d3a4a1591b04de24b156e15dd216eb93b77a
ZLIB_REPO=https://github.com/madler/zlib
ZLIB_REF=5a82f71ed1dfc0bec044d9702463dbdf84ea3b71
# lwIP for maxsdk's IOP TCP/IP stack (iop/tcpip/mxnet), at STABLE-2_2_1_RELEASE
LWIP_REPO=https://github.com/lwip-tcpip/lwip
LWIP_REF=77dcd25a72509eb83f72b033d219b1d40cd8eb95
PS2CLIENT_REPO=https://github.com/rickgaiser/ps2client
PS2CLIENT_REF=4af9c6a7a05a3a428270f2d836166cd3965bcb17

# IOP side from ps2dev (Alpine too): the IOP gcc, ps2sdk's IOP build files and prebuilt IRX modules
PS2SDK_IMAGE=ps2dev/ps2sdk@sha256:ca01c3d216a440553c7360313f2d27dcd3bb7ad74eaf37a6c55fbd628e14067a

# Fixed inputs of the images. The LLVM commit is not here: images.yml builds
# the images for every LLVM_REF the repos' ps2max.deps name. The ps2max
# libraries are not in the images: each build fetches the commits its own
# ps2max.deps names (scripts/fetch-deps.sh).

ALPINE=alpine:3.24

# llvm image: the R5900/VU LLVM (ps2max32/llvm, branch r5900-feature)
LLVM_REPO=https://github.com/ps2max32/llvm

# IOP side from ps2dev (Alpine too): ps2sdk's IOP headers and prebuilt IRX modules
PS2SDK_IMAGE=ps2dev/ps2sdk@sha256:ca01c3d216a440553c7360313f2d27dcd3bb7ad74eaf37a6c55fbd628e14067a
